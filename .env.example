# ============ LLM（智谱 GLM，OpenAI 兼容）============
# ⚠️ 必填：填入你的智谱 API Key（在 https://open.bigmodel.cn 获取）
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-4-flash

# ============ Embedding / Reranker 模型 ============
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ============ 知识库 / 向量检索 ============
CHROMA_PERSIST_DIR=./knowledge/chroma_db
CHUNK_SIZE=500
CHUNK_OVERLAP=50
CHUNK_PARENT_SIZE=1500
RETRIEVE_TOP_K=20
RERANK_TOP_N=5
# 是否启用 Reranker 重排（1=启用；0=关闭，跳过约 2.3GB 模型下载）
ENABLE_RERANKER=0

# ============ HuggingFace 下载加速（国内默认开启镜像）============
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1

# ============ 鉴权 ============
# API_KEY：非空 = 强制校验 X-API-Key 头；空 = 开发模式（免鉴权）
API_KEY=

# ============ 安全兜底 ============
RAG_CONFIDENCE_THRESHOLD=0.5
ENABLE_PII_MASK=1

# ============ 业务环境 ============
ENV=dev

# ============ 可靠性 ============
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ============ 前后端分离 / CORS ============
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
