# ============ DeepSeek LLM ============
# ⚠️ 必填：填入你的 DeepSeek API Key（在 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-xxxx-替换成你的真实key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============ Embedding / Reranker 模型 ============
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ============ 知识库 / 向量检索 ============
CHROMA_PERSIST_DIR=./knowledge/chroma_db
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVE_TOP_K=20
RERANK_TOP_N=5
# 是否启用 Reranker 重排（1=启用；0=关闭，跳过约 2.3GB 模型下载）
ENABLE_RERANKER=1

# ============ HuggingFace 下载加速（国内默认开启镜像）============
# 国内网络直连 HF 极慢，默认走镜像；海外部署可注释掉本行
HF_ENDPOINT=https://hf-mirror.com
# 大模型文件走 Xet 存储，hf-mirror 不代理其 CAS 接口会 401；禁 Xet 强制普通 HTTP 下载
HF_HUB_DISABLE_XET=1
