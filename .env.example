# ============ DeepSeek LLM ============
# ⚠️ 必填：填入你的 DeepSeek API Key（在 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-xxxx-替换成你的真实key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============ Embedding / Reranker 模型 ============
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ============ 知识库 / 向量检索 ============
CHROMA_PERSIST_DIR=./knowledge/chroma_db
CHUNK_SIZE=500
CHUNK_OVERLAP=50
# 父子块 §5.7：child 检索（精准），parent 注入 LLM（上下文完整，默认 3 倍 chunk）
CHUNK_PARENT_SIZE=1500
RETRIEVE_TOP_K=20
RERANK_TOP_N=5
# 是否启用 Reranker 重排（1=启用；0=关闭，跳过约 2.3GB 模型下载）
ENABLE_RERANKER=1

# ============ HuggingFace 下载加速（国内默认开启镜像）============
# 国内网络直连 HF 极慢，默认走镜像；海外部署可注释掉本行
HF_ENDPOINT=https://hf-mirror.com
# 大模型文件走 Xet 存储，hf-mirror 不代理其 CAS 接口会 401；禁 Xet 强制普通 HTTP 下载
HF_HUB_DISABLE_XET=1

# ============ Redis / 会话 / 审计 ============
# 本地开发用 localhost；Docker 内由 docker-compose 覆盖为 redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
# 是否记录审计日志（业务动作留痕，写 Redis）
AUDIT_ENABLED=1

# ============ 鉴权 / 多租户 / 限流 ============
# API_KEYS: JSON 映射 {"api_key": "tenant_id"}；留空 = 开发模式（不鉴权，tenant=default）
API_KEYS={"sk-local-dev":"default"}
RATE_LIMIT_PER_MINUTE=60

# ============ 安全兜底 ============
# RAG 置信度门槛：低于此值判定为「低置信度」，返回不确定 + 建议转人工
RAG_CONFIDENCE_THRESHOLD=0.0
# 是否对输出做 PII 脱敏（手机号/邮箱/身份证/银行卡）
ENABLE_PII_MASK=1

# ============ 业务对接 ============
# dev=业务工具用 mock 数据；prod=必须接真实业务接口（mock 路径显式报错）
ENV=dev

# ============ 可靠性 / 熔断降级（P1）============
# LLM 单次调用超时（秒）
LLM_TIMEOUT=60
# LLM 单次调用失败后的最大重试次数
LLM_MAX_RETRIES=2
# 熔断器：连续失败达阈值 → 打开（返回降级话术，不再调用 LLM）
CIRCUIT_FAILURE_THRESHOLD=3
# 熔断冷却期（秒），结束后进入半开
CIRCUIT_RESET_SECONDS=60

# ============ 流式断线重连（P2 §6.3）============
# SSE 心跳间隔（秒）：长回答期间无 token 时发注释行，防代理空闲超时
SSE_HEARTBEAT_SECONDS=15
# 断点续传缓冲 TTL（秒）：断线后此窗口内可重放，超时需重新生成
SSE_STREAM_TTL_SECONDS=120
